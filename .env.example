# 复制为 .env 后填写。所有配置均可被环境变量覆盖。

# ---- 存储 ----
BRAIN_DB_PATH=lclone.db

# ---- 模型后端: api | dummy(离线自测) ----
BRAIN_LLM=api

# OpenAI 兼容接口。示例:
#   OpenAI    https://api.openai.com/v1        chat: gpt-4o-mini      embed: text-embedding-3-small
#   Claude    https://api.anthropic.com/v1     chat: claude-3-5-haiku-latest  embed: (无, 用本地)
#   Gemini    https://generativelanguage.googleapis.com/v1beta/openai  chat: gemini-2.0-flash  embed: text-embedding-004
#   Copilot   https://models.inference.ai.azure.com  chat: gpt-4o-mini  embed: (无, 用本地; key=GitHub PAT)
#   Kimi      https://api.moonshot.cn/v1            chat: moonshot-v1-8k  embed: (无, 用本地)
#   MiniMax   https://api.minimaxi.com/v1           chat: MiniMax-Text-01  embed: (无, 用本地)
#   DeepSeek  https://api.deepseek.com/v1      chat: deepseek-v4-flash  embed: (不支持, 需用其他)
#   硅基流动  https://api.siliconflow.cn/v1    chat: Qwen/Qwen2.5-7B-Instruct  embed: BAAI/bge-m3
#   智谱      https://open.bigmodel.cn/api/paas/v4  chat: glm-4-flash
OPENAI_API_KEY=
BRAIN_BASE_URL=https://api.openai.com/v1
BRAIN_CHAT_MODEL=gpt-4o-mini
BRAIN_EMBED_MODEL=text-embedding-3-small
# embed 后端: api(真实向量接口) | local(本地确定性哈希, 用于 DeepSeek 等无 embed 接口的服务商)
BRAIN_EMBED_BACKEND=api
BRAIN_TEMPERATURE=0.3

# ---- Web 面板 ----
BRAIN_HOST=0.0.0.0
BRAIN_PORT=8000

# ---- 服务鉴权 (可选) ----
# 部署在服务器上时设置; 设了后 /api/* 与 /mcp 需要带
#   Authorization: Bearer <key>  或  X-API-Key: <key>
# 留空 = 本地免鉴权。
LCLONE_API_KEY=
