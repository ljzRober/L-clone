{
  "name": "lclone-memory-dsh",
  "version": "0.1.0",
  "type": "module",
  "description": "L-clone 记忆钩子：DSH 每轮结束(turn/end)自动 capture 到外置大脑 + 待确认决策横幅提醒。",
  "main": "dsh/index.js",
  "files": ["dsh/index.js", "dsh/client.js", "dsh/cordis.patch.yml"],
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./dsh/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh/cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "keywords": ["dsh-plugin", "memory", "lclone"],
  "license": "MIT"
}
